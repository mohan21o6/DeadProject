# DeadProject National Intelligence Platform Environment Variables

# Backend Server Port
PORT=5000

# GitHub REST API Credentials
# Provide a GitHub personal access token to raise rate limit from 60 req/hr to 5,000 req/hr
GITHUB_TOKEN=

# MongoDB Configuration (Optional - falls back to local JSON store if empty/not running)
MONGODB_URI=mongodb://localhost:27017/deadproject
MONGODB_DB_NAME=deadproject

# Dataset Storage Directories
ZENODO_DATASET_PATH=src/data/zenodo_unmaintained.csv
PROJECT_TRACKER_PATH=src/data/project_tracker_raw.json
MENDELEY_DATASET_DIR=src/data/mendeley
